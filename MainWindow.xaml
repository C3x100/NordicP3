<Window x:Class="NordicP3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NordicP3 - Volvo P3 ECM read / write" Height="900" Width="1080" MinHeight="600" MinWidth="900"
        Loaded="OnLoaded" Closing="OnClosing">
  <DockPanel Margin="12">

    <!-- Header -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="NordicP3" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Bottom" />
      <TextBlock x:Name="VersionText" FontSize="14" Foreground="Gray" Margin="8,0,0,3" VerticalAlignment="Bottom" />
    </StackPanel>

    <!-- Status bar -->
    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center" />
      <ProgressBar x:Name="Progress" Grid.Column="1" Height="18" Minimum="0" Maximum="100" />
      <Button x:Name="CancelBtn" Grid.Column="2" Content="Cancel" Click="OnCancel" IsEnabled="False"
              Margin="8,0,0,0" Padding="12,2" MinWidth="80" />
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="200" />
      </Grid.RowDefinitions>

      <!-- Left: connection and actions. Scrolls on short screens so no button is hidden. -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="Interface">
          <StackPanel>
            <ComboBox x:Name="DriverBox" Margin="0,0,0,6" SelectionChanged="OnDriverChanged" />
            <TextBlock x:Name="DriverDetail" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8" />
            <WrapPanel>
              <Button x:Name="BrowseDllBtn" Content="Choose DLL..." Click="OnBrowseDll" />
              <Button x:Name="RefreshBtn" Content="Rescan" Click="OnRescan" MinWidth="80" />
            </WrapPanel>
            <TextBlock Text="Module" Margin="0,4,0,2" />
            <ComboBox x:Name="ModuleBox" Margin="0,0,0,8" />
            <WrapPanel>
              <Button x:Name="ConnectBtn" Content="Connect" Click="OnConnect" />
              <Button x:Name="DisconnectBtn" Content="Disconnect" Click="OnDisconnect" IsEnabled="False" />
            </WrapPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Supply voltage">
          <StackPanel>
            <TextBlock x:Name="VoltText" Text="-- . -- V" FontSize="34" FontWeight="SemiBold" />
            <TextBlock x:Name="VoltHint" Foreground="Gray" FontSize="11"
                       Text="Read from OBD pin 16 by the interface. Keep a charger on during any write." TextWrapping="Wrap" />
          </StackPanel>
        </GroupBox>

        <GroupBox Header="ECU">
          <StackPanel>
            <WrapPanel>
              <Button x:Name="ReadInfoBtn" Content="Read ECU info" Click="OnReadInfo" IsEnabled="False" />
            </WrapPanel>
            <WrapPanel>
              <Button x:Name="DumpBtn" Content="Dump ECU to file..." Click="OnDump" IsEnabled="False" />
              <Button x:Name="FlashBtn" Content="Write file to ECU..." Click="OnFlash" IsEnabled="False"
                      Foreground="DarkRed" />
            </WrapPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="DTCs" Margin="0">
          <WrapPanel>
            <Button x:Name="ReadDtcBtn" Content="Read DTCs" Click="OnReadDtcs" IsEnabled="False" />
            <Button x:Name="ClearDtcBtn" Content="Clear DTCs" Click="OnClearDtcs" IsEnabled="False" />
          </WrapPanel>
        </GroupBox>
      </StackPanel>
      </ScrollViewer>

      <!-- Right: info + DTCs -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <GroupBox Header="ECU information">
          <ListView x:Name="InfoList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Item" Width="220" DisplayMemberBinding="{Binding Key}" />
                <GridViewColumn Header="Value" Width="420" DisplayMemberBinding="{Binding Value}" />
              </GridView>
            </ListView.View>
          </ListView>
        </GroupBox>
        <GroupBox Header="Trouble codes" Grid.Row="1">
          <ListView x:Name="DtcList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Code" Width="120" DisplayMemberBinding="{Binding Key}" />
                <GridViewColumn Header="Status" Width="200" DisplayMemberBinding="{Binding Value}" />
              </GridView>
            </ListView.View>
          </ListView>
        </GroupBox>
      </Grid>

      <!-- Bottom: log -->
      <GroupBox Header="Log" Grid.Row="1" Grid.ColumnSpan="3" Margin="0">
        <DockPanel>
          <CheckBox x:Name="RawTraffic" DockPanel.Dock="Top" Content="Show raw TX/RX bytes" Margin="0,0,0,4"
                    IsChecked="True" />
          <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </DockPanel>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>
